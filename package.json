{
  "name": "hermes2claudecode",
  "version": "1.0.0",
  "author": "maanimis",
  "description": "Hermes OAuth device-flow client for CLIProxyAPI — authenticates Claude/Gemini/Codex accounts and stores tokens locally.",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "dev:once": "tsx src/index.ts",
    "web": "node web/server.js",
    "prod": "",
    "build": "tsc",
    "prebuild": "rimraf dist",
    "type-check": "tsc --noEmit",
    "check": "biome check --write --no-errors-on-unmatched",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "bin": {
    "temps": "dist/temps.bundled.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maanimis/temps.git"
  },
  "homepage": "https://github.com/maanimis/temps",
  "bugs": {
    "url": "https://github.com/maanimis/temps/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "preferGlobal": true,
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.1.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "got": "^15.1.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "open": "^11.0.1",
    "socks-proxy-agent": "^10.1.0",
    "tough-cookie": "^6.0.1",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "keywords": []
}
