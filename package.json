{
  "name": "useclaudeproxy",
  "version": "3.4.0",
  "author": "maanimeisam",
  "description": "useclaudeproxy — OAuth device-flow CLI that authenticates the Hermes CLI and runs CLIProxyAPI as a local OpenAI/Claude/Gemini/Codex proxy.",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "dev:once": "tsx src/index.ts",
    "web": "node web/server.js",
    "prod": "node ./dist/index.js",
    "build": "tsc",
    "prebuild": "rimraf dist",
    "type-check": "tsc --noEmit",
    "check": "biome check --write --no-errors-on-unmatched",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "useclaudeproxy": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maanimeisam/useclaudeproxy.git"
  },
  "homepage": "https://github.com/maanimeisam/useclaudeproxy",
  "bugs": {
    "url": "https://github.com/maanimeisam/useclaudeproxy/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "preferGlobal": true,
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.1.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "got": "^15.1.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "open": "^11.0.1",
    "socks-proxy-agent": "^10.1.0",
    "tough-cookie": "^6.0.1",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "claude",
    "CLIProxyAPI",
    "claudecode",
    "useclaudeproxy"
  ],
  "allowScripts": {
    "file:.pnpm/got@15.1.0/node_modules/got": true,
    "file:.pnpm/globals@17.11.0/node_modules/globals": true,
    "file:.pnpm/rimraf@6.1.3/node_modules/rimraf": true,
    "file:../../../@sindresorhus+is@8.1.0/node_modules/@sindresorhus/is": true,
    "file:../../tinyexec@1.3.0/node_modules/tinyexec": true,
    "file:../../esbuild@0.28.2/node_modules/esbuild": true,
    "file:../../glob@13.0.6/node_modules/glob": true,
    "file:../../package-json-from-dist@1.0.1/node_modules/package-json-from-dist": true,
    "file:../../content-type@2.1.0/node_modules/content-type": true,
    "file:../../path-to-regexp@8.4.2/node_modules/path-to-regexp": true,
    "file:../../ip-address@10.5.0/node_modules/ip-address": true,
    "file:../../minimatch@10.2.6/node_modules/minimatch": true,
    "file:../../minipass@7.1.3/node_modules/minipass": true,
    "file:../../path-scurry@2.0.2/node_modules/path-scurry": true,
    "file:../../brace-expansion@5.0.9/node_modules/brace-expansion": true,
    "file:../../lru-cache@11.5.2/node_modules/lru-cache": true,
    "file:../../balanced-match@4.0.4/node_modules/balanced-match": true
  }
}
